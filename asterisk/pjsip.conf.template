; Rendered by docker-entrypoint.sh from env. See README.md.
; Meta path (TLS + DTLS-SRTP + Opus) is the production path.
; Loopback path (UDP, no auth, private nets only) is for local sipp/probe tests.

[transport-udp]
type = transport
protocol = udp
bind = 0.0.0.0:5060
local_net = 172.16.0.0/12
local_net = 127.0.0.0/8

[transport-tls]
type = transport
protocol = tls
bind = 0.0.0.0:5061
cert_file = /etc/asterisk/keys/asterisk.pem
priv_key_file = /etc/asterisk/keys/asterisk.key
method = tlsv1_2
external_media_address = ${EXTERN_IP}
external_signaling_address = ${EXTERN_IP}
local_net = 172.16.0.0/12
local_net = 127.0.0.0/8

[meta-auth]
type = auth
auth_type = userpass
username = ${META_SIP_USERNAME}
password = ${META_SIP_PASSWORD}

[meta-endpoint]
type = endpoint
context = from-meta
disallow = all
allow = opus,ulaw,alaw
transport = transport-tls
auth = meta-auth
media_encryption = dtls
dtls_verify = no
dtls_setup = actpass
dtls_cert_file = /etc/asterisk/keys/asterisk.pem
dtls_private_key = /etc/asterisk/keys/asterisk.key
ice_support = yes
rtp_symmetric = yes
rewrite_contact = yes
direct_media = no

[meta-identify]
type = identify
endpoint = meta-endpoint
match = ${META_SIP_ALLOW}

[loopback]
type = endpoint
context = from-meta
disallow = all
allow = ulaw,alaw
transport = transport-udp
direct_media = no

[loopback-identify]
type = identify
endpoint = loopback
match = 172.16.0.0/12
match = 127.0.0.0/8
